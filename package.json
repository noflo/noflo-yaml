{
  "name": "@noflo/yaml",
  "description": "YAML handling components for the NoFlo flow-based programming environment",
  "version": "2.0.0-alpha.1",
  "author": {
    "name": "Henri Bergius",
    "email": "henri.bergius@iki.fi",
    "url": "http://bergie.iki.fi"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/noflo/noflo-yaml.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "noflo"
  ],
  "files": [
    "components/",
    "graphs/",
    "spec/",
    "test/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@noflo/noflo": "^2.0.0-alpha.0",
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@noflo/fbp-spec-runner": "^2.0.0-alpha.0",
    "@noflo/loader-node": "^2.0.0-alpha.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true components/ 'spec/**/*.yaml' test/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write components/ 'spec/**/*.yaml' test/",
    "types": "tsc -p tsconfig.json",
    "test": "npm run types && npm run lint && npm run test:spec && npm run test:node",
    "test:spec": "node \"$(node -p \"require.resolve('@noflo/fbp-spec-runner/src/cli.js')\")\" spec/",
    "test:node": "node --test test/*.test.js",
    "test:bun": "bun test test/*.test.js",
    "test:deno": "deno test --allow-all --no-check test/*.test.js"
  }
}
